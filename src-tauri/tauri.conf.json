{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StageCue",
  "version": "0.1.6",
  "identifier": "com.stagecue.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "StageCue",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "devtools": false,
        "label": "main",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "StageCue",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "licenseFile": "../LICENSE-EULA.txt",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5NjAzNjBGQzI5MzQ4QzQKUldURVNKUENEelpnS1dZMzdoZXUxbGRJRFlQUU5aQkM1MVpybWNYckkwZ1k0bmNPWW1oazBtMXIK",
      "endpoints": [
        "https://github.com/Noahvilder/stagecueshow/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}