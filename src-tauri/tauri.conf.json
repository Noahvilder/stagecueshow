{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StageCue",
  "version": "0.1.5",
  "identifier": "com.stagecue.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "StageCue",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "devtools": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "StageCue",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "licenseFile": "../LICENSE-EULA.txt",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
